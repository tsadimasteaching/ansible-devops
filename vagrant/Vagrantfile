ENV["VAGRANT_DEFAULT_PROVIDER"] ||= "libvirt"

Vagrant.configure("2") do |config|
  if Vagrant.has_plugin?("vagrant-hostmanager")
    config.hostmanager.enabled = true
    config.hostmanager.manage_host = true
  end

  config.vm.box = "cloud-image/ubuntu-24.04"

  config.vm.provider :libvirt do |lv, override|
    lv.memory = 1024
    lv.cpus = 1
    # virtiofs χρειάζεται shared memory
    lv.memorybacking :access, mode: "shared"
    # Αμφίδρομος φάκελος /vagrant (το control γράφει το control.pub, οι άλλοι το διαβάζουν).
    # Το default του libvirt είναι rsync, που αντιγράφει μόνο host -> guest.
    override.vm.synced_folder ".", "/vagrant", type: "virtiofs"
  end

  # VirtualBox: vagrant up --provider=virtualbox
  # (ο /vagrant είναι ήδη αμφίδρομος, με vboxsf)
  config.vm.provider :virtualbox do |vb|
    vb.memory = 1024
    vb.cpus = 1
  end

  config.vm.define "control", primary: true do |h|
    h.vm.hostname = "control"
    h.vm.network "private_network", ip: "192.168.56.10"
    h.vm.provision "shell", path: "scripts/key.sh"
  end

  config.vm.define "appserver" do |h|
    h.vm.hostname = "appserver"
    h.vm.network "private_network", ip: "192.168.56.101"
    h.vm.provision :shell, inline: 'cat /vagrant/control.pub >> /home/vagrant/.ssh/authorized_keys'
  end

  config.vm.define "frontserver" do |h|
    h.vm.hostname = "frontserver"
    h.vm.network "private_network", ip: "192.168.56.103"
    h.vm.provision :shell, inline: 'cat /vagrant/control.pub >> /home/vagrant/.ssh/authorized_keys'
  end

  config.vm.define "dbserver" do |h|
    h.vm.hostname = "dbserver"
    h.vm.network "private_network", ip: "192.168.56.102"
    h.vm.provision :shell, inline: 'cat /vagrant/control.pub >> /home/vagrant/.ssh/authorized_keys'
  end
end
